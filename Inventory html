<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory - Spare Parts Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f4f6f9;
        }
        .card {
            box-shadow: 0 2px 8px rgba(0,0,0,.1);
        }
        .table th {
            background: #0d6efd;
            color: white;
        }
    </style>
</head>

<body>

<div class="container mt-4">

    <h2 class="mb-4">📦 Spare Parts Inventory</h2>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            Add New Spare Part
        </div>

        <div class="card-body">

            <form action="/add_part" method="POST">

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label>Part Name</label>
                        <input type="text" name="part_name" class="form-control" required>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label>Part Number</label>
                        <input type="text" name="part_number" class="form-control" required>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label>Category</label>
                        <input type="text" name="category" class="form-control">
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Quantity</label>
                        <input type="number" name="quantity" class="form-control">
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Minimum Stock</label>
                        <input type="number" name="minimum_stock" class="form-control">
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Unit Price</label>
                        <input type="number" step="0.01" name="unit_price" class="form-control">
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Supplier</label>
                        <input type="text" name="supplier" class="form-control">
                    </div>

                </div>

                <button class="btn btn-success">
                    ➕ Save Spare Part
                </button>

            </form>

        </div>
    </div>

    <div class="card">

        <div class="card-header bg-dark text-white">
            Inventory List
        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead>
                    <tr>
                        <th>Part Name</th>
                        <th>Part Number</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Minimum</th>
                        <th>Unit Price</th>
                        <th>Supplier</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    {% for part in parts %}

                    <tr>

                        <td>{{ part.part_name }}</td>
                        <td>{{ part.part_number }}</td>
                        <td>{{ part.category }}</td>
                        <td>{{ part.quantity }}</td>
                        <td>{{ part.minimum_stock }}</td>
                        <td>${{ part.unit_price }}</td>
                        <td>{{ part.supplier }}</td>

                        <td>

                            {% if part.quantity <= part.minimum_stock %}

                            <span class="badge bg-danger">
                                Low Stock
                            </span>

                            {% else %}

                            <span class="badge bg-success">
                                In Stock
                            </span>

                            {% endif %}

                        </td>

                    </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>

</body>
</html>
